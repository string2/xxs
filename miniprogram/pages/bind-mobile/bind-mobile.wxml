<view class="bind-mobile-page">
  <view class="page-hero">
    <view class="hero-safe"></view>
    <view class="hero-title">绑定身份信息</view>
    <view class="hero-desc">请填写学校已备案的姓名和手机号</view>
  </view>

  <view class="form-sheet">
    <view class="form-group">
      <view class="form-label">姓名</view>
      <view class="input-box">
        <input
          class="input-inner"
          type="text"
          maxlength="20"
          placeholder="请输入真实姓名"
          placeholder-class="input-ph"
          value="{{name}}"
          bindinput="onName"
        />
      </view>
    </view>

    <view class="form-group">
      <view class="form-label">手机号</view>
      <view class="input-box">
        <input
          class="input-inner"
          type="number"
          maxlength="11"
          placeholder="请输入本人手机号"
          placeholder-class="input-ph"
          value="{{mobile}}"
          bindinput="onMobile"
        />
      </view>
    </view>

    <view class="bind-tip">姓名与手机号需与后台备案信息一致方可绑定</view>

    <button class="btn-submit" hover-class="btn-submit-hover" bindtap="submit">确认绑定</button>

    <view class="demo-tip">
      <view class="demo-title">演示账号</view>
      <view>学生：张三 / 13800000001</view>
      <view>宿管：王宿管 / 13900000001</view>
    </view>
  </view>
</view>
