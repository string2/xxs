.legal-page {
  min-height: 100vh;
  background: #f5f3ee;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

.legal-hero {
  padding: 36rpx 36rpx 28rpx;
  background: #0f1c24;
  color: #fff;
}

.legal-title {
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.legal-updated {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.65);
}

.legal-body {
  margin: 24rpx 24rpx 0;
  padding: 32rpx 28rpx;
  border-radius: 24rpx;
  background: #fff;
}

.legal-section + .legal-section {
  margin-top: 32rpx;
  padding-top: 28rpx;
  border-top: 1rpx solid rgba(15, 28, 36, 0.06);
}

.legal-heading {
  font-size: 30rpx;
  font-weight: 700;
  color: #0f1c24;
  margin-bottom: 14rpx;
}

.legal-p {
  font-size: 26rpx;
  line-height: 1.75;
  color: #3d5563;
  margin-bottom: 12rpx;
}

.legal-p:last-child {
  margin-bottom: 0;
}
