<view class="legal-page">
  <view class="legal-hero">
    <view class="legal-title">{{title}}</view>
    <view class="legal-updated">更新日期：{{updated}}</view>
  </view>

  <view class="legal-body">
    <view class="legal-section" wx:for="{{sections}}" wx:key="heading">
      <view class="legal-heading">{{item.heading}}</view>
      <view class="legal-p" wx:for="{{item.paragraphs}}" wx:for-item="p" wx:key="*this">{{p}}</view>
    </view>
  </view>
</view>
