.news-page {
  min-height: 100vh;
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
  background: #f5f3ee;
}

.news-card {
  position: relative;
  z-index: 2;
  margin: 20rpx 28rpx 0;
  border-top: none;
  border-radius: 22rpx;
  padding: 0;
  overflow: hidden;
  box-shadow: 0 12rpx 32rpx rgba(15, 28, 36, 0.07);
}

.news-stack {
  overflow: hidden;
}

.news-item {
  display: flex;
  align-items: center;
  padding: 28rpx 26rpx;
  background: #fff;
  border-bottom: 1rpx solid rgba(15, 28, 36, 0.06);
}

.news-item:last-child {
  border-bottom: none;
}

.news-item:active {
  background: #f7f5f0;
}

.news-icon {
  width: 56rpx;
  height: 56rpx;
  margin-right: 18rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 700;
  color: #fff;
  background: #0f1c24;
}

.news-icon.tone-intro { background: #0f1c24; background-color: #0f1c24; }
.news-icon.tone-feature { background: #1a2e3a; background-color: #1a2e3a; }
.news-icon.tone-rule { background: #b0893f; background-color: #b0893f; }
.news-icon.tone-news { background: #8a6a2b; background-color: #8a6a2b; }

.news-main {
  flex: 1;
  min-width: 0;
}

.news-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #0f1c24;
  line-height: 1.4;
}

.news-cat {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #6b7c86;
}

.news-arrow {
  width: 14rpx;
  height: 14rpx;
  margin-right: 4rpx;
  border-top: 3rpx solid rgba(15, 28, 36, 0.16);
  border-right: 3rpx solid rgba(15, 28, 36, 0.16);
  transform: rotate(45deg);
  flex-shrink: 0;
}

.news-empty {
  padding: 72rpx 40rpx;
  text-align: center;
  font-size: 26rpx;
  color: #9aa8b0;
  background: #fff;
}
