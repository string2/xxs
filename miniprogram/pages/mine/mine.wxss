.mine-page {
  min-height: 100vh;
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
  background: #f5f3ee;
}

.mine-banner {
  position: relative;
  min-height: calc(300rpx + env(safe-area-inset-top));
  height: auto;
  padding: 96px 40rpx 40rpx;
  box-sizing: border-box;
  overflow: hidden;
  border: none;
  box-shadow: none;
}

.mine-banner-bg {
  position: absolute;
  left: 0;
  right: 0;
  top: -2px;
  bottom: 0;
  background:
    radial-gradient(ellipse 64% 40% at 18% 42%, rgba(212, 175, 97, 0.14), transparent 58%),
    linear-gradient(180deg, #0f1c24 0%, #152833 52%, #1a303c 100%);
}

.mine-banner-inner {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: flex-start;
  gap: 32rpx;
  min-height: 160rpx;
}

/* ===== 头像（左） ===== */
.avatar-stage {
  flex-shrink: 0;
  width: 160rpx;
  height: 160rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-btn {
  position: relative;
  display: flex !important;
  align-items: center;
  justify-content: center;
  width: 160rpx !important;
  height: 160rpx !important;
  min-width: 160rpx !important;
  max-width: 160rpx !important;
  padding: 0 !important;
  margin: 0 !important;
  border: none !important;
  border-radius: 50% !important;
  background: transparent !important;
  background-color: transparent !important;
  line-height: 1 !important;
  overflow: visible !important;
  box-sizing: border-box;
}

.avatar-btn::after {
  border: none !important;
}

.avatar-btn-hover {
  opacity: 0.92;
}

.avatar-ring {
  width: 144rpx;
  height: 144rpx;
  padding: 5rpx;
  border-radius: 50%;
  background: #b0893f;
  box-shadow: 0 12rpx 28rpx rgba(0, 0, 0, 0.26);
  box-sizing: border-box;
}

.avatar-img,
.avatar-fallback {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  display: block;
  border: 4rpx solid #0f1c24;
  outline: none;
  box-sizing: border-box;
}

.avatar-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  font-weight: 700;
  color: #0f1c24;
  background: #f3efe6;
}

.avatar-edit {
  position: absolute;
  right: 6rpx;
  bottom: 6rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #b0893f;
  border: 3rpx solid #0f1c24;
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-edit-icon {
  width: 15rpx;
  height: 11rpx;
  border: 2rpx solid #fff;
  border-radius: 3rpx;
  position: relative;
  box-sizing: border-box;
}

.avatar-edit-icon::before {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 5rpx;
  height: 5rpx;
  margin: -2.5rpx 0 0 -2.5rpx;
  border: 2rpx solid #fff;
  border-radius: 50%;
  box-sizing: border-box;
}

.avatar-edit-icon::after {
  content: "";
  position: absolute;
  left: 2rpx;
  top: -4rpx;
  width: 5rpx;
  height: 3rpx;
  background: #fff;
  border-radius: 2rpx 2rpx 0 0;
}

/* ===== 资料（右）：三行等高均分，与头像垂直对称 ===== */
.profile-info {
  flex: 1;
  min-width: 0;
  height: 160rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  align-items: stretch;
  padding: 4rpx 0;
  box-sizing: border-box;
}

.profile-row {
  display: flex;
  align-items: center;
  min-height: 40rpx;
}

.mine-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: 1rpx;
  line-height: 1.2;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.mine-mobile {
  font-size: 26rpx;
  letter-spacing: 1rpx;
  color: rgba(255, 255, 255, 0.7);
  line-height: 1.2;
}

.mine-mobile.muted {
  color: rgba(255, 255, 255, 0.4);
}

.meta-tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  color: rgba(255, 255, 255, 0.92);
  background: rgba(255, 255, 255, 0.1);
  border: 1rpx solid rgba(212, 175, 97, 0.35);
  line-height: 1.2;
}

.meta-tag.role-parent,
.meta-tag.role-student,
.meta-tag.role-dorm {
  color: rgba(255, 255, 255, 0.92);
  background: rgba(255, 255, 255, 0.1);
}

/* ===== 下方功能卡片 ===== */
.mine-sheet {
  position: relative;
  z-index: 2;
  margin: 24rpx 28rpx 0;
  padding: 8rpx 0 24rpx;
  background: #ffffff;
  border-radius: 28rpx;
  box-shadow: 0 14rpx 36rpx rgba(15, 28, 36, 0.07);
  overflow: hidden;
}

.tool-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 28rpx 28rpx;
  border-bottom: 1rpx solid rgba(15, 28, 36, 0.06);
}

.tool-item:active {
  background: rgba(15, 28, 36, 0.03);
}

.tool-left {
  display: flex;
  align-items: center;
  gap: 18rpx;
  min-width: 0;
}

.tool-icon {
  width: 44rpx;
  height: 44rpx;
  position: relative;
  flex-shrink: 0;
}

.ic-bind {
  box-sizing: border-box;
}

.ic-bind::before,
.ic-bind::after {
  content: "";
  position: absolute;
  width: 22rpx;
  height: 22rpx;
  border: 3rpx solid #b0893f;
  border-radius: 6rpx;
}

.ic-bind::before {
  left: 4rpx;
  top: 8rpx;
}

.ic-bind::after {
  right: 4rpx;
  bottom: 8rpx;
  background: rgba(255, 255, 255, 0.95);
}

.tool-copy {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
}

.tool-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #0f1c24;
}

.tool-desc {
  font-size: 22rpx;
  color: #6b7c86;
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 420rpx;
}

.tool-arrow {
  width: 14rpx;
  height: 14rpx;
  border-top: 3rpx solid rgba(15, 28, 36, 0.18);
  border-right: 3rpx solid rgba(15, 28, 36, 0.18);
  transform: rotate(45deg);
  flex-shrink: 0;
}

.sheet-block {
  padding: 28rpx 28rpx 0;
}

.sheet-label {
  position: relative;
  padding-left: 16rpx;
  font-size: 28rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  color: #0f1c24;
  margin-bottom: 18rpx;
}

.sheet-label::before {
  content: "";
  position: absolute;
  left: 0;
  top: 8rpx;
  bottom: 8rpx;
  width: 5rpx;
  border-radius: 4rpx;
  background: #b0893f;
}

.quick-grid {
  display: flex;
  flex-direction: row;
  flex-wrap: nowrap;
  align-items: stretch;
}

.quick-item {
  flex: 1;
  width: 0;
  margin-right: 16rpx;
  padding: 24rpx 20rpx;
  border-radius: 20rpx;
  background: #f7f5f0;
  border: 1rpx solid rgba(15, 28, 36, 0.05);
  box-sizing: border-box;
}

.quick-item:last-child {
  margin-right: 0;
}

.quick-item:active {
  opacity: 0.88;
  background: #f0ebe2;
}

.quick-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #0f1c24;
}

.quick-desc {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #6b7c86;
  line-height: 1.4;
}

/* ===== 校园资讯 ===== */
.mine-news-stack {
  border-radius: 18rpx;
  overflow: hidden;
  background: #f7f5f0;
  border: 1rpx solid rgba(15, 28, 36, 0.05);
}

.mine-news-item {
  display: flex;
  align-items: center;
  padding: 22rpx 20rpx;
  border-bottom: 1rpx solid rgba(15, 28, 36, 0.06);
}

.mine-news-item:last-child {
  border-bottom: none;
}

.mine-news-item:active {
  background: #f0ebe2;
}

.mine-news-icon {
  width: 52rpx;
  height: 52rpx;
  margin-right: 16rpx;
  border-radius: 14rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 700;
  color: #fff;
  background: #0f1c24;
}

.mine-news-icon.tone-intro { background: #0f1c24; }
.mine-news-icon.tone-feature { background: #1a2e3a; }
.mine-news-icon.tone-rule { background: #b0893f; }
.mine-news-icon.tone-news { background: #8a6a2b; }

.mine-news-main {
  flex: 1;
  min-width: 0;
}

.mine-news-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #0f1c24;
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.mine-news-cat {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #6b7c86;
}

.mine-news-arrow {
  width: 12rpx;
  height: 12rpx;
  margin-left: 8rpx;
  border-top: 3rpx solid rgba(15, 28, 36, 0.16);
  border-right: 3rpx solid rgba(15, 28, 36, 0.16);
  transform: rotate(45deg);
  flex-shrink: 0;
}

.mine-news-empty {
  padding: 36rpx 20rpx;
  text-align: center;
  font-size: 24rpx;
  color: #9aa8b0;
  background: #f7f5f0;
  border-radius: 18rpx;
}

.logout-link {
  margin: 28rpx 28rpx 0;
  padding: 24rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  color: #0f1c24;
  border-radius: 18rpx;
  background: #f7f5f0;
  border: 1rpx solid rgba(15, 28, 36, 0.1);
}

.logout-link:active {
  opacity: 0.82;
  background: #f0ebe2;
}
