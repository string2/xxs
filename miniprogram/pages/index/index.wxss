.service-page {
  min-height: 100vh;
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
  background: #f5f3ee;
}

.service-page .hero {
  height: calc(480rpx + env(safe-area-inset-top));
  padding: calc(36rpx + env(safe-area-inset-top)) 40rpx 72rpx;
  box-sizing: border-box;
}

.service-page .hero-inner {
  justify-content: flex-end;
  padding-bottom: 8rpx;
}

.service-page .brand {
  margin-bottom: 10rpx;
  font-size: 18rpx;
  letter-spacing: 0.22em;
  color: rgba(212, 175, 97, 0.95);
}

.service-page .hero-title {
  font-size: 56rpx;
  letter-spacing: 4rpx;
}

.service-page .hero-sub {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.88);
}

.service-page .role-chip {
  margin-top: 20rpx;
  padding: 8rpx 20rpx;
  background: rgba(15, 28, 36, 0.5);
  border: 1rpx solid rgba(212, 175, 97, 0.35);
  font-size: 22rpx;
}

/* 宣传语单独成卡，与校园服务分离 */
.motto-card {
  position: relative;
  z-index: 2;
  margin: -36rpx 28rpx 0;
  padding: 28rpx 24rpx;
  text-align: center;
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 12rpx 32rpx rgba(15, 28, 36, 0.08);
}

.motto-text {
  font-size: 24rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  color: #0f1c24;
  line-height: 1.4;
}

.service-sheet {
  position: relative;
  z-index: 2;
  margin: 20rpx 28rpx 0;
  padding: 0 0 12rpx;
  background: #ffffff;
  border-radius: 28rpx;
  box-shadow: 0 14rpx 36rpx rgba(15, 28, 36, 0.08);
  overflow: hidden;
}

.service-head {
  display: flex;
  align-items: center;
  padding: 28rpx 28rpx 8rpx;
}

.service-title {
  position: relative;
  padding-left: 16rpx;
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  color: #0f1c24;
}

.service-title::before {
  content: "";
  position: absolute;
  left: 0;
  top: 8rpx;
  bottom: 8rpx;
  width: 6rpx;
  border-radius: 4rpx;
  background: #b0893f;
}

.service-page .menu-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 12rpx 12rpx 20rpx;
}

.service-page .menu-cell {
  width: 33.333%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 8rpx 20rpx;
  box-sizing: border-box;
  animation: fadeUp 0.5s ease both;
}

.service-page .menu-cell:active {
  opacity: 0.88;
  transform: scale(0.96);
}

.service-page .menu-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 28rpx;
  box-shadow: 0 10rpx 22rpx rgba(15, 28, 36, 0.14);
}

.service-page .menu-label {
  margin-top: 16rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #0f1c24;
  line-height: 1.3;
}

.empty {
  padding: 48rpx 40rpx 56rpx;
  text-align: center;
  font-size: 26rpx;
  color: #6b7c86;
}

.empty-icon {
  display: block;
  width: 72rpx;
  height: 72rpx;
  margin: 0 auto 16rpx;
  border-radius: 20rpx;
  background: #f3efe6;
  color: #b0893f;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 72rpx;
}
