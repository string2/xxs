.dorm-page {
  min-height: 100vh;
  padding: 28rpx 28rpx calc(40rpx + env(safe-area-inset-bottom));
  background: transparent;
}

.dorm-page.batch-mode {
  padding-bottom: calc(220rpx + env(safe-area-inset-bottom));
}

.dorm-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.head-actions {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 12rpx;
}

.batch-toggle {
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #0b3d32;
  background: rgba(11, 61, 50, 0.08);
  border: 1rpx solid rgba(11, 61, 50, 0.12);
}

.batch-toggle.active {
  color: #ffffff;
  background: #0f1c24;
  background-color: #0f1c24;
  border-color: #0f1c24;
}

.batch-tip {
  margin: -8rpx 0 16rpx;
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  font-size: 22rpx;
  color: #5f736b;
  background: rgba(11, 61, 50, 0.06);
  line-height: 1.5;
}

.dorm-title {
  flex: 1;
  min-width: 0;
  font-size: 36rpx;
  font-weight: 700;
  color: #1a2744;
  letter-spacing: 1rpx;
  line-height: 1.3;
}

.floor-tabs {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  padding: 6rpx;
  border-radius: 16rpx;
  background: #e8eaee;
}

.floor-tab {
  min-width: 64rpx;
  padding: 12rpx 18rpx;
  text-align: center;
  font-size: 24rpx;
  font-weight: 600;
  color: #8a93a3;
  border-radius: 12rpx;
}

.floor-tab.active {
  color: #1a2744;
  background: #ffffff;
  box-shadow: 0 4rpx 12rpx rgba(26, 39, 68, 0.08);
}

.dorm-card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 28rpx 22rpx 24rpx;
  box-shadow: 0 8rpx 28rpx rgba(26, 39, 68, 0.04);
}

.room-grid {
  display: flex;
  flex-wrap: wrap;
}

.room-cell {
  position: relative;
  width: calc(25% - 16rpx);
  margin: 8rpx;
  height: 148rpx;
  border-radius: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  transition: transform 0.15s ease;
}

.room-cell:active {
  transform: scale(0.96);
}

.room-no {
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.2;
}

.room-status {
  margin-top: 8rpx;
  font-size: 22rpx;
  font-weight: 500;
  line-height: 1.2;
}

.room-dot {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #e5484d;
}

/* 正常 */
.status-normal {
  background: #e8f7ef;
}
.status-normal .room-no,
.status-normal .room-status {
  color: #1f8a4c;
}

/* 有请假 */
.status-leave {
  background: #fdecee;
}
.status-leave .room-no,
.status-leave .room-status {
  color: #d92d20;
}

/* 未查寝 */
.status-unchecked {
  background: #f1f2f4;
}
.status-unchecked .room-no,
.status-unchecked .room-status {
  color: #9aa0a8;
}

/* 异常 */
.status-abnormal {
  background: #fff4e5;
}
.status-abnormal .room-no,
.status-abnormal .room-status {
  color: #c47a12;
}

.dorm-legend {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 36rpx;
  margin-top: 28rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid #eef0f3;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 22rpx;
  color: #6b7280;
}

.legend-sq {
  width: 22rpx;
  height: 22rpx;
  border-radius: 6rpx;
}

.sq-normal {
  background: #34c759;
}

.sq-leave {
  background: #e5484d;
}

.sq-unchecked {
  background: #c5c9d0;
}

.room-cell.selected {
  box-shadow: 0 0 0 4rpx rgba(11, 61, 50, 0.35);
  transform: scale(0.98);
}

.room-check {
  position: absolute;
  top: 10rpx;
  left: 10rpx;
  z-index: 2;
}

.check-box {
  width: 28rpx;
  height: 28rpx;
  border-radius: 8rpx;
  border: 2rpx solid rgba(11, 61, 50, 0.35);
  background: rgba(255, 255, 255, 0.9);
  box-sizing: border-box;
}

.check-box.checked {
  background: #0b3d32;
  border-color: #0b3d32;
  position: relative;
}

.check-box.checked::after {
  content: "";
  position: absolute;
  left: 8rpx;
  top: 4rpx;
  width: 8rpx;
  height: 14rpx;
  border-right: 3rpx solid #fff;
  border-bottom: 3rpx solid #fff;
  transform: rotate(45deg);
}

.batch-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  padding: 20rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.98);
  border-top: 1rpx solid #eef0f3;
  box-shadow: 0 -8rpx 32rpx rgba(26, 39, 68, 0.08);
}

.batch-bar-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.batch-select-all {
  font-size: 24rpx;
  font-weight: 600;
  color: #0b3d32;
}

.batch-count {
  font-size: 22rpx;
  color: #6b7280;
}

.batch-actions {
  display: flex;
  gap: 12rpx;
}

.batch-btn {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  border-radius: 16rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.batch-btn:active {
  opacity: 0.88;
}

.btn-normal {
  color: #1f8a4c;
  background: #e8f7ef;
}

.btn-abnormal {
  color: #c47a12;
  background: #fff4e5;
}

.btn-leave {
  color: #d92d20;
  background: #fdecee;
}

.empty {
  padding: 80rpx 20rpx;
  text-align: center;
  color: #9aa0a8;
  font-size: 26rpx;
}
