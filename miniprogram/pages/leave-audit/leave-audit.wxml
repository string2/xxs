<view class="sub-page">
  <view class="page-top fade-up">
    <view class="page-top-title">{{canAudit?'请假审核':'请假详情'}}</view>
    <view class="page-top-desc">#{{leave.id}}</view>
  </view>

  <view class="card fade-up">
    <view class="data-item" style="padding:0;border:none;">
      <view class="data-dot warn"></view>
      <view class="data-body">
        <view class="data-title">{{leave.leave_type==='sick'?'病假':'事假'}}</view>
        <view class="data-sub">状态：{{statusLabel}}</view>
      </view>
    </view>
    <view class="field-label">请假日期</view>
    <view class="muted">{{dateRange}}</view>
    <view class="field-label">请假原因</view>
    <view class="muted">{{leave.reason}}</view>
  </view>

  <view class="card fade-up" wx:if="{{statusLabel==='已批准' || gateCount}}">
    <view class="field-label">扫码开门记录（{{gateCount}} 次）</view>
    <view class="gate-row" wx:for="{{gateRecords}}" wx:key="id">
      <text class="gate-time">{{item.time_text}}</text>
      <text class="gate-dir">{{item.direction_text}}</text>
    </view>
    <view class="muted" wx:if="{{!gateCount}}">暂无扫码记录，可据此判断学生是否进出校门</view>
  </view>

  <block wx:if="{{canAudit}}">
    <button class="btn-primary" bindtap="agree">同意请假</button>
    <button class="btn-warn" bindtap="reject">拒绝请假</button>
  </block>
</view>
